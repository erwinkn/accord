  },
  "dependencies": {
    "@accord/client": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": ">=18"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
