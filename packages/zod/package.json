{
  "name": "@accord/zod",
  "version": "0.1.0-alpha.0",
  "description": "Native Zod schema code generation adapter for Accord",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "peerDependencies": {
    "zod": "^4.4.3",
    "@accord/codegen": "0.1.0-alpha.0"
  },
  "devDependencies": {
    "zod": "4.6.5",
    "@accord/codegen": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@accord/codegen": {
      "optional": true
    }
  }
}
