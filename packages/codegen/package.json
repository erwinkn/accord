{
  "name": "@accord/codegen",
  "version": "0.1.0-alpha.0",
  "description": "OpenAPI to Accord endpoint descriptor and TypeScript generator",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "bin": {
    "accord": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@accord/client": "workspace:*",
    "typescript": "5.9.3",
    "yaml": "2.9.1",
    "import-meta-resolve": "4.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
