{
  "name": "accord",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Type-safe OpenAPI SDK code generation with a small generic runtime",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "clean": "pnpm -r clean && rm -rf coverage tests/generated",
    "generate:test-fixtures": "tsx scripts/generate-test-fixtures.ts",
    "lint": "biome lint . && oxlint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "quality": "biome ci --diagnostic-level=error --max-diagnostics=1000 . && oxlint",
    "typecheck": "pnpm build && pnpm generate:test-fixtures && pnpm -r --workspace-concurrency=1 typecheck && tsc -p tests/type/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:golden": "vitest run --config vitest.golden.config.ts",
    "test:property": "vitest run --config vitest.property.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:fuzz": "tsx tests/conformance/fuzz.ts",
    "check": "pnpm quality && pnpm typecheck && pnpm typecheck:tests && pnpm test && pnpm test:harness && pnpm test:conformance && ACCORD_FUZZ_RUNS=20 pnpm test:fuzz && pnpm test:distribution",
    "test:types": "pnpm typecheck",
    "lint:anti-slop": "oxlint",
    "test:conformance": "tsx tests/conformance/runner.ts",
    "test:conformance:strict": "tsx tests/conformance/runner.ts --strict",
    "test:conformance:list": "tsx tests/conformance/runner.ts --list",
    "test:harness": "vitest run --config vitest.conformance.config.ts",
    "test:distribution": "tsx tests/conformance/distribution.ts",
    "typecheck:tests": "tsc -p tests/conformance/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@accord/client": "workspace:*",
    "@accord/codegen": "workspace:*",
    "@accord/react-query": "workspace:*",
    "@biomejs/biome": "2.5.13",
    "@oxlint/plugins": "1.82.0",
    "@tanstack/react-query": "5.102.8",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fast-check": "4.9.0",
    "happy-dom": "20.14.3",
    "oxlint": "1.82.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
