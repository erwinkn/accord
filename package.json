{
  "name": "accord",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Type-safe OpenAPI SDK code generation with a small generic runtime",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "clean": "pnpm -r clean && rm -rf coverage tests/generated",
    "generate:test-fixtures": "tsx scripts/generate-test-fixtures.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "quality": "biome ci .",
    "typecheck": "pnpm build && pnpm generate:test-fixtures && pnpm -r --workspace-concurrency=1 typecheck && tsc -p tests/type/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:golden": "vitest run --config vitest.golden.config.ts",
    "test:property": "vitest run --config vitest.property.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:fuzz": "node scripts/fuzz-openapi.mjs",
    "check": "pnpm quality && pnpm typecheck && pnpm test && ACCORD_FUZZ_RUNS=50 pnpm test:fuzz",
    "test:types": "pnpm typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@tanstack/react-query": "5.101.4",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fast-check": "4.9.0",
    "happy-dom": "20.11.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
