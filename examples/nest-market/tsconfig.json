{
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "sdk/**/*.ts",
    "test/**/*.ts",
    "*.ts",
    "*.tsx",
    "web/**/*.ts",
    "web/**/*.tsx"
  ]
}
