{
  "name": "@accord/example-nest-market",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.server.json",
    "clean": "rm -rf dist",
    "generate": "pnpm build && node dist/scripts/generate.js",
    "start": "pnpm build && node dist/src/main.js",
    "demo": "pnpm build && tsx demo.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "dev": "pnpm build && node dev.mjs",
    "build:web": "vite build",
    "test:web": "playwright test"
  },
  "dependencies": {
    "@accord/client": "workspace:*",
    "@accord/react-query": "workspace:*",
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/swagger": "7.4.2",
    "@tanstack/react-query": "5.102.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@accord/codegen": "workspace:*",
    "@accord/zod": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/express": "4.17.25",
    "@types/multer": "2.0.0",
    "@types/node": "26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "zod": "4.4.3"
  }
}
